generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// NOTE: This schema uses Prisma 6.x syntax (project version: 6.19.0)
// The `url` property in datasource is valid for Prisma 6.x
// Ignore lint errors about Prisma 7.x migration - this is intentional
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAccess {
  id          String @id @default(cuid())
  ip_address  String
  user_agent  String
  device_name String

  url    String
  method MethodEnum

  created_at DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  @@map("user_access")
}

enum MethodEnum {
  GET
  POST
  PUT
  DELETE
  PATCH
}

model User {
  id        String  @id @default(cuid())
  name      String
  email     String
  cellphone String?
  password  String?

  created_at DateTime @default(now())

  deleted_at DateTime?
  deleted_by String?

  user_access    UserAccess[]
  user_providers UserProvider[]

  @@map("user")
}

model UserProvider {
  id          String       @id @default(cuid())
  provider    ProviderEnum
  provider_id String

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  @@map("user_provider")
}

enum ProviderEnum {
  GOOGLE
  CINEMA
}
